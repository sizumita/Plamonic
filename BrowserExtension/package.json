{
  "name": "plamonic-browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Plamonic for Safari and Chrome: translates web pages with the Plamonic app on this Mac.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
