{
  "manifest_version": 3,
  "name": "Plamonic Spike",
  "description": "Checks that YouTube captions can be captured and passed to a Mac app, in Safari and Chrome.",
  "version": "0.0.1",
  "key": "",
  "permissions": ["nativeMessaging", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
